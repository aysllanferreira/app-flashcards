NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Base URL of the API, read only by server-side code. Defaults to
# http://localhost:3001 outside production.
API_URL=

# Signed-in Playwright tests (pnpm test:e2e) sign in as this test user of the
# Clerk development instance. Put it in .env.test.local (git-ignored); without
# it those tests are skipped.
# E2E_CLERK_USER_EMAIL=
