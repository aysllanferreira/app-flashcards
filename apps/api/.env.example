# Copy to .env to override the defaults. Outside production, DATABASE_URL
# defaults to the local Docker database (`docker compose up -d --wait db`).
DATABASE_URL=postgres://flashcards:flashcards@localhost:5432/flashcards

# Web app origins (comma-separated), used for CORS and to check the authorized
# party (azp) of Clerk session tokens. Defaults to http://localhost:3000
# outside production.
WEB_ORIGIN=http://localhost:3000
# Clerk token verification: the JWT public key (Clerk dashboard > API keys)
# verifies without a network call; the secret key is the fallback. Without
# either, every non-public route answers 401. Required (one of them) in
# production.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_URL=
CLERK_WEBHOOK_SIGNING_SECRET=